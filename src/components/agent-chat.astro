---
// 访客侧悬浮 AI 聊天：面板 + 触发按钮，交互逻辑在 src/scripts/agent-chat.ts
---
<div id="agent-chat-root" transition:persist="agent-chat">
  <div
    id="agent-chat-panel"
    class="agent-chat-panel glass"
    role="dialog"
    aria-label="AI 助手"
    aria-hidden="true"
    hidden
  >
    <header class="agent-chat-head">
      <span class="agent-chat-title">AI 助手</span>
      <button id="agent-chat-new" type="button" class="agent-chat-new">新对话</button>
      <button id="agent-chat-close" type="button" class="agent-chat-close" aria-label="关闭">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </header>
    <div id="agent-chat-messages" class="agent-chat-messages" aria-live="polite"></div>
    <p id="agent-chat-error" class="agent-chat-error" role="alert" hidden></p>
    <form id="agent-chat-form" class="agent-chat-form">
      <input
        id="agent-chat-input"
        class="agent-chat-input"
        type="text"
        maxlength="4000"
        placeholder="输入消息…"
        aria-label="输入消息"
        autocomplete="off"
      />
      <button id="agent-chat-send" type="submit" class="agent-chat-send" aria-label="发送">
        <span class="t-icon-swap" data-state="a" aria-hidden="true">
          <span class="t-icon" data-icon="a">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 12 7-7 7 7"></path>
              <path d="M12 19V5"></path>
            </svg>
          </span>
          <span class="t-icon" data-icon="b">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor"></rect>
            </svg>
          </span>
        </span>
      </button>
    </form>
  </div>
  <button id="agent-chat-fab" class="agent-chat-fab" type="button" aria-label="打开 AI 助手">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
  </button>
</div>

<style>
  .agent-chat-fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: #0059b5;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 89, 181, 0.32);
    transform: scale(1);
    transition:
      transform 200ms var(--motion-ease-out),
      box-shadow 200ms var(--motion-ease-out),
      background-color 200ms var(--motion-ease-out);
  }

  .agent-chat-fab[hidden] {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .agent-chat-fab:hover {
      background: #004d9e;
      box-shadow: 0 14px 34px rgba(0, 89, 181, 0.4);
      transform: translateY(-2px);
    }
  }

  .agent-chat-fab:active {
    transform: scale(0.94);
  }

  .agent-chat-fab:focus-visible {
    outline: 2px solid #0071e3;
    outline-offset: 4px;
  }

  .agent-chat-panel {
    --floor: 0.85;
    position: fixed;
    right: 24px;
    bottom: 32px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: 360px;
    height: min(520px, 70vh);
    border-radius: 20px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(14px) scale(0.98);
    transition:
      transform 220ms var(--motion-ease-lift),
      opacity 200ms var(--motion-ease-lift),
      visibility 0s linear 220ms;
  }

  .agent-chat-panel[hidden] {
    display: none;
  }

  .agent-chat-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition-delay: 0s;
  }

  .agent-chat-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 12px 10px 16px;
    border-bottom: 1px solid var(--row-hover);
  }

  .agent-chat-title {
    flex: 1;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 650;
  }

  .agent-chat-new {
    border: none;
    background: transparent;
    padding: 6px 10px;
    border-radius: 9999px;
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: color 180ms var(--motion-ease-out), background-color 180ms var(--motion-ease-out);
  }

  .agent-chat-new:hover {
    color: var(--glass-accent);
    background: var(--row-hover);
  }

  .agent-chat-close {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transform: scale(1);
    transition: color 180ms var(--motion-ease-out), background-color 180ms var(--motion-ease-out), transform 140ms var(--motion-ease-press);
  }

  .agent-chat-close:hover {
    color: var(--ink);
    background: var(--row-hover);
  }

  .agent-chat-close:active {
    transform: scale(0.92);
  }

  .agent-chat-messages {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .agent-chat-error {
    margin: 0;
    padding: 0 16px 8px;
    color: #dc2626;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.4;
  }

  .agent-chat-form {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px 14px;
    border-top: 1px solid var(--row-hover);
  }

  .agent-chat-input {
    flex: 1;
    min-width: 0;
    height: 40px;
    padding: 0 14px;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 9999px;
    background: var(--row-hover);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
    outline: none;
    transition:
      border-color var(--motion-duration-standard) var(--motion-ease-out),
      box-shadow var(--motion-duration-standard) var(--motion-ease-out);
  }

  .agent-chat-input::placeholder {
    color: var(--ink-2);
  }

  .agent-chat-input:focus {
    border-color: #0059b5;
    box-shadow: 0 0 0 3px rgba(0, 89, 181, 0.1);
  }

  .agent-chat-input:disabled {
    opacity: 0.55;
  }

  .agent-chat-send {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: #0059b5;
    color: #ffffff;
    cursor: pointer;
    transform: scale(1);
    transition:
      transform 140ms var(--motion-ease-press),
      background-color 180ms var(--motion-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .agent-chat-send:hover {
      background: #004d9e;
    }
  }

  .agent-chat-send:active {
    transform: scale(0.92);
  }

  .agent-chat-send .t-icon {
    display: grid;
    place-items: center;
  }

  @media (max-width: 640px) {
    .agent-chat-fab {
      right: 16px;
      bottom: 16px;
    }

    .agent-chat-panel {
      right: 16px;
      bottom: 16px;
      width: calc(100vw - 32px);
    }
  }
</style>

<style is:global>
  /* 消息气泡由 agent-chat.ts 动态创建，scoped 样式选不中，按 root 命名空间写全局 */
  #agent-chat-root .agent-chat-msg {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 14px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }

  #agent-chat-root .agent-chat-msg-user {
    align-self: flex-end;
    background: #0059b5;
    color: #ffffff;
  }

  #agent-chat-root .agent-chat-msg-bot {
    align-self: flex-start;
    background: var(--row-hover, rgba(0, 0, 0, 0.06));
    color: var(--ink, rgba(0, 0, 0, 0.86));
  }
</style>

<script src="../scripts/agent-chat.ts"></script>
