---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="API 管理" current="api">
  <div class="admin-page-header">
    <h1 class="admin-page-title">API 管理</h1>
    <p class="admin-page-desc">配置 LLM API 连接信息，供后台 AI 功能调用。</p>
  </div>

  <section class="form-section" id="card-llm">
    <div class="section-header">
      <h2 class="section-title">LLM API 设置</h2>
      <span class="section-badge" id="badge-llm">检测中</span>
    </div>
    <div class="llm-fields">
      <div class="field-group">
        <label for="llm-base-url" class="field-label">Base URL</label>
        <input id="llm-base-url" type="url" class="field-input" placeholder="https://api.openai.com/v1" />
      </div>
      <div class="field-group">
        <label for="llm-api-key" class="field-label">API Key</label>
        <div class="password-input-wrapper">
          <input id="llm-api-key" type="password" class="field-input" placeholder="输入 API Key (留空表示不修改)" />
          <button type="button" class="btn-toggle-password" tabindex="-1">
            <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>
      <div class="field-group">
        <label for="llm-model" class="field-label">模型名称</label>
        <div class="model-combobox">
          <input id="llm-model" type="text" class="field-input" placeholder="gpt-4o-mini" autocomplete="off" />
          <button type="button" class="combobox-toggle" tabindex="-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <ul id="llm-model-list" class="combobox-list"></ul>
        </div>
      </div>
      <div class="llm-actions">
        <button type="button" id="btn-save-llm" class="btn-primary btn-small">保存并测试</button>
        <span id="status-llm" class="save-status"></span>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import { requestLlmChat } from "../../scripts/admin-llm";

  document.addEventListener("astro:page-load", () => {
    async function fetchConfig() {
      try {
        const res = await fetch("/api/env-config");
        const data = await res.json();
        if (data.ok && data.config) {
          const conf = data.config;

          (document.getElementById("llm-base-url") as HTMLInputElement).value = conf.LLM_BASE_URL || "";
          (document.getElementById("llm-model") as HTMLInputElement).value = conf.LLM_MODEL || "";
          if (conf.LLM_API_KEY === "true") {
            (document.getElementById("llm-api-key") as HTMLInputElement).value = "********";
          }
          updateBadge("llm", conf.LLM_API_KEY === "true" && !!conf.LLM_BASE_URL && !!conf.LLM_MODEL);
        }
      } catch (err) {
        console.error("Failed to load env config", err);
      }
    }

    function updateBadge(prefix: string, isOk: boolean) {
      const badge = document.getElementById(`badge-${prefix}`);
      if (badge) {
        badge.textContent = isOk ? "已配置" : "未配置";
        badge.className = isOk ? "section-badge is-ok" : "section-badge";
      }
    }

    async function saveConfig() {
      const statusEl = document.getElementById("status-llm");
      if (statusEl) {
        statusEl.textContent = "保存中...";
        statusEl.className = "save-status is-info";
      }

      const baseUrl = (document.getElementById("llm-base-url") as HTMLInputElement).value.trim();
      const apiKey = (document.getElementById("llm-api-key") as HTMLInputElement).value.trim();
      const model = (document.getElementById("llm-model") as HTMLInputElement).value.trim();

      const updates: Record<string, string> = {
        LLM_BASE_URL: baseUrl,
        LLM_MODEL: model,
      };
      if (apiKey && apiKey !== "********") {
        updates.LLM_API_KEY = apiKey;
      }

      try {
        const res = await fetch("/api/env-config", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(updates)
        });
        const data = await res.json();

        if (data.ok) {
          if (statusEl) {
            statusEl.textContent = "保存成功，正在测试连接...";
            statusEl.className = "save-status is-info";
          }
          const conf = data.config;
          updateBadge("llm", conf.LLM_API_KEY === "true" && !!conf.LLM_BASE_URL && !!conf.LLM_MODEL);

          if (apiKey && apiKey !== "********") {
            (document.getElementById("llm-api-key") as HTMLInputElement).value = "********";
          }

          try {
            const reply = await requestLlmChat({
              baseUrl,
              model,
              apiKey: apiKey === "********" ? "" : apiKey,
              messages: [{ role: "user", content: "Hello, reply with OK only." }],
              maxTokens: 100,
            });
            if (statusEl) {
              statusEl.textContent = `保存并连接成功: ${reply.trim().substring(0, 50)}`;
              statusEl.className = "save-status is-success";
            }
          } catch (testErr) {
            if (statusEl) {
              statusEl.textContent = "保存成功，但连接失败: " + (testErr instanceof Error ? testErr.message : String(testErr));
              statusEl.className = "save-status is-error";
            }
          }
        } else {
          throw new Error(data.message || "保存失败");
        }
      } catch (err) {
        if (statusEl) {
          statusEl.textContent = String(err);
          statusEl.className = "save-status is-error";
        }
      }
      setTimeout(() => { if (statusEl) statusEl.textContent = ""; }, 5000);
    }

    document.getElementById("btn-save-llm")?.addEventListener("click", saveConfig);

    let detectTimeout: number | undefined;

    async function detectModels(prefix: string) {
      const baseUrl = (document.getElementById(`${prefix}-base-url`) as HTMLInputElement).value.trim();
      let apiKey = (document.getElementById(`${prefix}-api-key`) as HTMLInputElement).value.trim();
      if (apiKey === "********") apiKey = "";

      const badge = document.getElementById(`badge-${prefix}`);
      if (!baseUrl) {
        if (badge && badge.textContent !== "已配置") badge.textContent = "未配置";
        return;
      }

      if (badge) {
        badge.textContent = "检测中...";
        badge.className = "section-badge";
      }

      try {
        const res = await fetch("/api/llm-models", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ baseUrl, apiKey, type: prefix })
        });
        const data = await res.json();

        if (data.ok && data.models) {
          const listId = `${prefix}-model-list`;
          const list = document.getElementById(listId);
          if (list) {
            list.innerHTML = data.models.map((m: any) => `<li class="combobox-item">${m.id}</li>`).join("");
          }

          // Auto-select first model if empty
          const input = document.getElementById(`${prefix}-model`) as HTMLInputElement;
          if (input && !input.value && data.models.length > 0) {
            input.value = data.models[0].id;
          }

          if (badge) {
            badge.textContent = `已检测到 ${data.models.length} 个模型`;
            badge.className = "section-badge is-ok";
          }
        } else {
          if (badge) {
            badge.textContent = "获取模型失败";
            badge.className = "section-badge is-error";
          }
        }
      } catch {
        if (badge) {
          badge.textContent = "获取模型失败";
          badge.className = "section-badge is-error";
        }
      }
    }

    const triggerDetect = () => {
      clearTimeout(detectTimeout);
      detectTimeout = window.setTimeout(() => detectModels("llm"), 800);
    };
    document.getElementById("llm-base-url")?.addEventListener("input", triggerDetect);
    document.getElementById("llm-api-key")?.addEventListener("input", triggerDetect);

    // Custom Combobox Logic
    function setupCombobox() {
      const input = document.getElementById("llm-model") as HTMLInputElement;
      const toggle = input?.nextElementSibling as HTMLButtonElement;
      const list = document.getElementById("llm-model-list") as HTMLUListElement;

      if (!input || !toggle || !list) return;

      let _selecting = false;

      // Toggle list
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const isShowing = list.classList.contains("show");
        document.querySelectorAll(".combobox-list").forEach(el => el.classList.remove("show"));
        if (!isShowing && list.children.length > 0) {
          list.querySelectorAll(".combobox-item").forEach((item: any) => item.style.display = "block");
          list.classList.add("show");
        }
      });

      // Select item
      list.addEventListener("click", (e) => {
        const item = (e.target as HTMLElement).closest(".combobox-item");
        if (item) {
          _selecting = true;
          input.value = item.textContent || "";
          list.classList.remove("show");
          // Allow other listeners (e.g. outside change handlers) to react,
          // but suppress the filter handler from re-opening the list.
          setTimeout(() => { _selecting = false; }, 0);
        }
      });

      // Close on outside click
      document.addEventListener("click", (e) => {
        const wrapper = input.closest(".model-combobox");
        if (wrapper && !wrapper.contains(e.target as Node)) {
          list.classList.remove("show");
        }
      });

      // Filter on typing (user-initiated only)
      input.addEventListener("input", () => {
        if (_selecting) return;
        const val = input.value.toLowerCase();
        const items = list.querySelectorAll(".combobox-item");
        let hasVisible = false;
        items.forEach((item: any) => {
          const match = item.textContent.toLowerCase().includes(val);
          item.style.display = match ? "block" : "none";
          if (match) hasVisible = true;
        });
        if (hasVisible) {
          list.classList.add("show");
        } else {
          list.classList.remove("show");
        }
      });

      // Show full list on focus (only if items exist)
      input.addEventListener("focus", () => {
        if (list.children.length > 0) {
          list.querySelectorAll(".combobox-item").forEach((item: any) => item.style.display = "block");
          list.classList.add("show");
        }
      });
    }

    setupCombobox();

    // Password toggle
    document.querySelectorAll(".btn-toggle-password").forEach(btn => {
      btn.addEventListener("click", () => {
        const input = btn.previousElementSibling as HTMLInputElement;
        if (input.type === "password") {
          input.type = "text";
        } else {
          input.type = "password";
        }
      });
    });

    // Initial load
    fetchConfig();
  });
</script>

<style>
  .admin-page-header {
    margin-bottom: 24px;
  }
  .admin-page-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: #181c23;
    margin-bottom: 6px;
  }
  .admin-page-desc {
    font-size: 15px;
    color: #717785;
  }

  .form-section {
    max-width: 560px;
    background: #ffffff;
    border: 1px solid rgba(193, 198, 214, 0.5);
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 16px 40px rgba(0,0,0,0.06), 0 2px 10px rgba(0,0,0,0.03);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .section-title {
    font-size: 18px;
    font-weight: 600;
    color: #181c23;
    margin: 0;
  }
  .section-badge {
    padding: 3px 10px;
    border-radius: 8px;
    background: rgba(0,89,181,0.08);
    color: #717785;
    font-size: 12px;
    font-weight: 500;
    margin-left: auto;
  }
  .section-badge.is-ok {
    background: rgba(5, 150, 105, 0.1);
    color: #059669;
  }
  .section-badge.is-error {
    background: rgba(220, 38, 38, 0.1);
    color: #dc2626;
  }

  .llm-fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-label {
    font-size: 14px;
    font-weight: 500;
    color: #181c23;
  }
  .model-combobox {
    position: relative;
    display: flex;
    align-items: center;
  }
  .model-combobox .field-input {
    padding-right: 36px;
  }
  .combobox-toggle {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    color: #a0a8b8;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }
  .combobox-toggle:hover {
    color: #414753;
  }
  .combobox-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    max-height: 240px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid rgba(193,198,214,0.5);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.08), 0 2px 10px rgba(0,0,0,0.03);
    z-index: 100;
    margin: 0;
    padding: 8px;
    list-style: none;
    font-family: var(--font-body);
    /* Animation base */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition: all 0.25s cubic-bezier(0.19, 1, 0.22, 1);
    pointer-events: none;
  }
  .combobox-list.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  :global(.combobox-item) {
    padding: 10px 12px;
    margin: 2px 0;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: #414753;
    border-radius: 8px;
    transition: all 0.2s cubic-bezier(0.19, 1, 0.22, 1);
  }
  :global(.combobox-item:hover) {
    background: #f0f7ff;
    color: #0059b5;
    padding-left: 18px;
  }
  :global(.combobox-item:active) {
    background: #e0efff;
    transform: scale(0.98);
  }

  .password-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .password-input-wrapper .field-input {
    padding-right: 44px;
  }
  .btn-toggle-password {
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    color: #a0a8b8;
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }
  .btn-toggle-password:hover {
    color: #414753;
  }

  .field-input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgba(193,198,214,0.5);
    background: rgba(255,255,255,0.7);
    font-family: var(--font-body);
    font-size: 15px;
    color: #181c23;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .field-input:focus {
    border-color: #0059b5;
    box-shadow: 0 0 0 3px rgba(0,89,181,0.1);
  }

  .llm-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }
  .btn-primary {
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    background: #0059b5;
    color: #fff;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  .btn-primary:active { transform: scale(0.97); }

  .save-status {
    font-size: 13px;
    font-weight: 500;
  }
  .save-status.is-success { color: #059669; }
  .save-status.is-error { color: #dc2626; }
  .save-status.is-info { color: #0059b5; }

  #card-llm {
    background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 60%);
  }
</style>
