SQLITE_DB_PATH="./data/blog.sqlite"

# AI Gateway API 密钥（用于 AI 助手和 RAG 功能）
AI_GATEWAY_API_KEY=""
# AI 对话模型名称
AI_CHAT_MODEL="openai/gpt-4o-mini"
# AI 对话温度 (0-2)
AI_CHAT_TEMPERATURE="0.7"
# Embedding 模型名称
AI_EMBEDDING_MODEL="openai/text-embedding-3-small"
# Embedding 向量维度
AI_EMBEDDING_DIMENSIONS="1536"
# Rerank 模型名称
AI_RERANK_MODEL="cohere/rerank-v3.5"
# 是否启用 AI 清洗 (true/false)
RAG_ENABLE_AI_CLEANING="false"

# LLM API 密钥（用于后台 AI 润色功能）
LLM_API_KEY=""
# 直连 LLM 接口地址（可选；未设置 AI_GATEWAY_API_KEY 时，与 LLM_API_KEY、LLM_MODEL 同时配置才生效）
LLM_BASE_URL=""
# 直连 LLM 对话模型名称（可选）
LLM_MODEL=""

# Embedding 直连配置（可选；未设置 AI_GATEWAY_API_KEY 时，三项同时配置才生效，如硅基流动）
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL=""

# Rerank 直连配置（可选；未设置 AI_GATEWAY_API_KEY 时，三项同时配置才生效，如硅基流动 / Cohere）
RERANK_API_KEY=""
RERANK_BASE_URL=""
RERANK_MODEL=""

# 图片上传目录（可选，默认使用 public/uploads/，留空使用默认值）
# UPLOAD_DIR="/absolute/path/to/uploads"
GITHUB_TOKEN=""

# 管理后台用户名（可选，默认 admin）
ADMIN_USERNAME="admin"
# 必填！后台登录密码。没有默认值：缺失或留空时后台拒绝登录（服务日志与登录接口会给出指引）。务必使用强密码！
ADMIN_PASSWORD=""
# 必填！后台会话 JWT 签名密钥。缺失或留空时登录接口直接报错。生成方式：
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# 把命令输出的随机串粘贴到下面：
ADMIN_SECRET=""
